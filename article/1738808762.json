:none !important; -webkit-tap-highlight-color:rgba(0, 0, 0, 0)\" target=\"_blank\"\u003e\u003cspan style=\"color:#0000ff\"\u003e附小幼兒園新生入學登記表\u003c/span\u003e\u003c/a\u003e\u003cspan style=\"color:#000000\"\u003e及\u003c/span\u003e\u003cspan style=\"color:#ff0000\"\u003e全戶戶籍謄本影本一份及預防注射卡(姓名及注射欄位)影本\u003c/span\u003e\u003cspan style=\"color:#000000\"\u003e。\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\n\u003cp style=\"text-align:justify\"\u003e \u003c/p\u003e\n\n\u003cp style=\"margin-left:40px; text-align:justify\"\u003e\u003cspan style=\"font-size:18.48px\"\u003e\u003cspan style=\"color:#464646\"\u003e\u003cspan style=\"font-family:\u0026#34;Segoe UI\u0026#34;,Roboto,Verdana,微軟正黑體,\u0026#34;Microsoft JhengHei\u0026#34;,\u0026#34;Century Gothic\u0026#34;,\u0026#34;Trebuchet MS\u0026#34;,\u0026#34;Lucida Console\u0026#34;,Arial,Helvetica,Meiryo,sans-serif,\u0026#34;Microsoft YaHei\u0026#34;,微软雅黑体,微軟雅黑體\"\u003e\u003cspan style=\"background-color:rgba(255, 255, 255, 0.267)\"\u003e\u003cspan style=\"font-size:1em\"\u003e\u003cspan style=\"font-family:微軟正黑體\"\u003e\u003cspan style=\"color:#000000\"\u003e3.報到日：\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\n\u003cp style=\"margin-left:80px; text-align:justify\"\u003e\u003cspan style=\"font-size:18.48px\"\u003e\u003cspan style=\"color:#464646\"\u003e\u003cspan style=\"font-family:\u0026#34;Segoe UI\u0026#34;,Roboto,Verdana,微軟正黑體,\u0026#34;Microsoft JhengHei\u0026#34;,\u0026#34;Century Gothic\u0026#34;,\u0026#34;Trebuchet MS\u0026#34;,\u0026#34;Lucida Console\u0026#34;,Arial,Helvetica,Meiryo,sans-serif,\u0026#34;Microsoft YaHei\u0026#34;,微软雅黑体,微軟雅黑體\"\u003e\u003cspan style=\"background-color:rgba(255, 255, 255, 0.267)\"\u003e\u003cspan style=\"font-size:1em\"\u003e\u003cspan style=\"font-family:微軟正黑體\"\u003e\u003cspan style=\"color:#000000\"\u003e(1)國民小學：一年級新生報到日為\u003cspan style=\"background-color:yellow\"\u003e\u003cspan style=\"background-color:#ffcc99\"\u003e114\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"background-color:yellow\"\u003e\u003cspan style=\"background-color:#ffcc99\"\u003e年4\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"background-color:#ffcc99\"\u003e月21日(星期一)\u003c/span\u003e。\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\n\u003cp style=\"margin-left:120px; text-align:justify\"\u003e\u003cspan style=\"font-size:18.48px\"\u003e\u003cspan style=\"color:#464646\"\u003e\u003cspan style=\"font-family:\u0026#34;Segoe UI\u0026#34;,Roboto,Verdana,微軟正黑體,\u0026#34;Microsoft JhengHei\u0026#34;,\u0026#34;Century Gothic\u0026#34;,\u0026#34;Trebuchet MS\u0026#34;,\u0026#34;Lucida Console\u0026#34;,Arial,Helvetica,Meiryo,sans-serif,\u0026#34;Microsoft YaHei\u0026#34;,微软雅黑体,微軟雅黑體\"\u003e\u003cspan style=\"background-color:rgba(255, 255, 255, 0.267)\"\u003e\u003cspan style=\"font-size:1em\"\u003e\u003cspan style=\"font-family:微軟正黑體\"\u003e\u003cspan style=\"color:#000000\"\u003e4月9日召開新生入學資格審查會議後，\u003cstrong\u003e報到資料將由附小寄送給各一年級新生家長\u003c/strong\u003e，並請直接於報到當日，攜帶相關學籍資料至附小辦理報到。 \u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\n\u003cp style=\"margin-left:80px; text-align:justify\"\u003e\u003cspan style=\"font-size:18.48px\"\u003e\u003cspan style=\"color:#464646\"\u003e\u003cspan style=\"font-family:\u0026#34;Segoe UI\u0026#34;,Roboto,Verdana,微軟正黑體,\u0026#34;Microsoft JhengHei\u0026#34;,\u0026#34;Century Gothic\u0026#34;,\u0026#34;Trebuchet MS\u0026#34;,\u0026#34;Lucida Console\u0026#34;,Arial,Helvetica,Meiryo,sans-serif,\u0026#34;Microsoft YaHei\u0026#34;,微软雅黑体,微軟雅黑體\"\u003e\u003cspan style=\"background-color:rgba(255, 255, 255, 0.267)\"\u003e\u003cspan style=\"font-size:1em\"\u003e\u003cspan style=\"font-family:微軟正黑體\"\u003e\u003cspan style=\"color:#000000\"\u003e(2)幼兒園：將於\u003cstrong\u003e114年5月15日(星期四)上午10:00公布錄取名單於本校附設實驗國民小學首頁及幼兒園大門。\u003c/strong\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\n\u003cp style=\"margin-left:120px; text-align:justify\"\u003e\u003cspan style=\"font-size:18.48px\"\u003e\u003cspan style=\"color:#464646\"\u003e\u003cspan style=\"font-family:\u0026#34;Segoe UI\u0026#34;,Roboto,Verdana,微軟正黑體,\u0026#34;Microsoft JhengHei\u0026#34;,\u0026#34;Century Gothic\u0026#34;,\u0026#34;Trebuchet MS\u0026#34;,\u0026#34;Lucida Console\u0026#34;,Arial,Helvetica,Meiryo,sans-serif,\u0026#34;Microsoft YaHei\u0026#34;,微软雅黑体,微軟雅黑體\"\u003e\u003cspan style=\"background-color:rgba(255, 255, 255, 0.267)\"\u003e\u003cspan style=\"font-size:1em\"\u003e\u003cspan style=\"font-family:微軟正黑體\"\u003e\u003cspan style=\"color:#000000\"\u003e錄取幼兒家長請在114年5月16日(星期五)上午9:00至12:00到幼兒園(地址：花蓮市民權九街10號)辦理報到手續，未在時間內辦理報到手續者，視同放棄。\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\n\u003cp style=\"text-align:justify\"\u003e \u003c/p\u003e\n\n\u003cp style=\"margin-left:40px; text-align:justify\"\u003e\u003cspan style=\"font-size:18.48px\"\u003e\u003cspan style=\"color:#464646\"\u003e\u003cspan style=\"font-family:\u0026#34;Segoe UI\u0026#34;,Roboto,Verdana,微軟正黑體,\u0026#34;Microsoft JhengHei\u0026#34;,\u0026#34;Century Gothic\u0026#34;,\u0026#34;Trebuchet MS\u0026#34;,\u0026#34;Lucida Console\u0026#34;,Arial,Helvetica,Meiryo,sans-serif,\u0026#34;Microsoft YaHei\u0026#34;,微软雅黑体,微軟雅黑體\"\u003e\u003cspan style=\"background-color:rgba(255, 255, 255, 0.267)\"\u003e\u003cspan style=\"font-size:1em\"\u003e\u003cspan style=\"font-family:微軟正黑體\"\u003e\u003cspan style=\"color:#000000\"\u003e4.轉學：\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\n\u003cp style=\"margin-left:80px; text-align:justify\"\u003e\u003cspan style=\"font-size:18.48px\"\u003e\u003cspan style=\"color:#464646\"\u003e\u003cspan style=\"font-family:\u0026#34;Segoe UI\u0026#34;,Roboto,Verdana,微軟正黑體,\u0026#34;Microsoft JhengHei\u0026#34;,\u0026#34;Century Gothic\u0026#34;,\u0026#34;Trebuchet MS\u0026#34;,\u0026#34;Lucida Console\u0026#34;,Arial,Helvetica,Meiryo,sans-serif,\u0026#34;Microsoft YaHei\u0026#34;,微软雅黑体,微軟雅黑體\"\u003e\u003cspan style=\"background-color:rgba(255, 255, 255, 0.267)\"\u003e\u003cspan style=\"font-size:1em\"\u003e\u003cspan style=\"font-family:微軟正黑體\"\u003e\u003cspan style=\"color:#000000\"\u003e欲轉學就讀附小幼兒園或2-6年級的學生家長，請參閱國立東華大學附設實驗國民小學招收轉學生辦法並填妥下列欄位。\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\n\u003cp style=\"margin-left:80px; text-align:justify\"\u003e\u003cspan style=\"font-size:18.48px\"\u003e\u003cspan style=\"color:#464646\"\u003e\u003cspan style=\"font-family:\u0026#34;Segoe UI\u0026#34;,Roboto,Verdana,微軟正黑體,\u0026#34;Microsoft JhengHei\u0026#34;,\u0026#34;Century Gothic\u0026#34;,\u0026#34;Trebuchet MS\u0026#34;,\u0026#34;Lucida Console\u0026#34;,Arial,Helvetica,Meiryo,sans-serif,\u0026#34;Microsoft YaHei\u0026#34;,微软雅黑体,微軟雅黑體\"\u003e\u003cspan style=\"background-color:rgba(255, 255, 255, 0.267)\"\u003e\u003cspan style=\"font-size:1em\"\u003e\u003cspan style=\"font-family:微軟正黑體\"\u003e\u003cspan style=\"color:#000000\"\u003e該年級若有缺額產生，將於寒、暑假通知遞補。\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\n\u003cp style=\"margin-left:40px; text-align:justify\"\u003e \u003c/p\u003e\n\n\u003cp style=\"margin-left:40px; text-align:justify\"\u003e\u003cspan style=\"font-size:18.48px\"\u003e\u003cspan style=\"color:#464646\"\u003e\u003cspan style=\"font-family:\u0026#34;Segoe UI\u0026#34;,Roboto,Verdana,微軟正黑體,\u0026#34;Microsoft JhengHei\u0026#34;,\u0026#34;Century Gothic\u0026#34;,\u0026#34;Trebuchet MS\u0026#34;,\u0026#34;Lucida Console\u0026#34;,Arial,Helvetica,Meiryo,sans-serif,\u0026#34;Microsoft YaHei\u0026#34;,微软雅黑体,微軟雅黑體\"\u003e\u003cspan style=\"background-color:rgba(255, 255, 255, 0.267)\"\u003e\u003cspan style=\"font-size:1em\"\u003e\u003cspan style=\"font-family:微軟正黑體\"\u003e\u003cspan style=\"color:#000000\"\u003e5.填表及繳交附件截止日：\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"font-family:微軟正黑體\"\u003e\u003cstrong\u003e\u003cspan style=\"color:#ffffff\"\u003e\u003cspan style=\"background-color:yellow\"\u003e\u003cspan style=\"background-color:#ff0000\"\u003e114\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"background-color:yellow\"\u003e\u003cspan style=\"background-color:#ff0000\"\u003e年3\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"background-color:#ff0000\"\u003e月3日(星期一)17時止。\u003c/span\u003e\u003c/span\u003e\u003c/strong\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\n\u003cp style=\"margin-left:40px; text-align:justify\"\u003e \u003c/p\u003e\n\n\u003cp style=\"margin-left:40px; text-align:justify\"\u003e\u003cspan style=\"font-size:18.48px\"\u003e\u003cspan style=\"color:#464646\"\u003e\u003cspan style=\"font-family:\u0026#34;Segoe UI\u0026#34;,Roboto,Verdana,微軟正黑體,\u0026#34;Microsoft JhengHei\u0026#34;,\u0026#34;Century Gothic\u0026#34;,\u0026#34;Trebuchet MS\u0026#34;,\u0026#34;Lucida Console\u0026#34;,Arial,Helvetica,Meiryo,sans-serif,\u0026#34;Microsoft YaHei\u0026#34;,微软雅黑体,微軟雅黑體\"\u003e\u003cspan style=\"background-color:rgba(255, 255, 255, 0.267)\"\u003e\u003cspan style=\"font-size:18.48px\"\u003e\u003cspan style=\"color:#464646\"\u003e\u003cspan style=\"font-family:\u0026#34;Segoe UI\u0026#34;,Roboto,Verdana,微軟正黑體,\u0026#34;Microsoft JhengHei\u0026#34;,\u0026#34;Century Gothic\u0026#34;,\u0026#34;Trebuchet MS\u0026#34;,\u0026#34;Lucida Console\u0026#34;,Arial,Helvetica,Meiryo,sans-serif,\u0026#34;Microsoft YaHe